# Copy to apps/api/.env and adjust:
NODE_ENV=development
API_PORT=8080
API_HOST=0.0.0.0
API_URL="http://localhost:8080"
WEB_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wishubest"
JWT_SECRET="change-me-to-a-long-random-secret"
AUTH_COOKIE="wishubest_session"
SESSION_TTL_SECONDS=604800
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage/private-documents"
DOC_SIGNED_URL_TTL_SECONDS=300
SEED_ADMIN_EMAIL="admin@wishubest.local"
SEED_ADMIN_PASSWORD="Admin123!"