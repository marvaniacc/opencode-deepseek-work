generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum Role {
  patient
  provider
  admin
}

enum ProviderType {
  doctor
  hospital
  hotel
  translator
}

enum ProviderStatus {
  pending
  active
  suspended
  rejected
}

enum KycStatus {
  pending
  submitted
  approved
  rejected
}

enum BookingStatus {
  draft
  requested
  awaiting_payment
  confirmed
  cancelled
  completed
  rejected
}

enum ServiceMode {
  in_person
  online
}

enum InvoiceStatus {
  draft
  issued
  paid
  void
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum ChatThreadStatus {
  active
  archived
}

enum TranslationProvider {
  openai
  anthropic
  mock
}

enum DocumentStatus {
  active
  archived
}

// ------------------------------------------------------------------
// Users & roles
// ------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(patient)
  locale        String    @default("fa") // fa | en
  status        String    @default("active") // active | disabled
  emailVerified DateTime?

  patientProfile  PatientProfile?
  providerProfile ProviderProfile?
  adminProfile    AdminProfile?
  sessions        Session[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  chatMessages    ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PatientProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  nationalId    String?
  phone         String?
  dateOfBirth   DateTime?
  avatarFileKey String?

  bookings         Booking[]
  chatThreads      ChatThread[]
  medicalDocuments PatientMedicalDocument[]
  accessGrants     MedicalDocumentAccessGrant[]
  reviews          Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String?
  superAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderProfile {
  id           String         @id @default(cuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerType ProviderType   @default(doctor)
  title        String? // e.g. "Dr."
  specialty    String? // e.g. "Cardiologist"
  bio          String?
  status       ProviderStatus @default(pending)
  kycStatus    KycStatus      @default(pending)
  verifiedAt   DateTime?

  // Platform commission in basis points (e.g. 1000 = 10%).
  platformFeeBps Int @default(1000)

  kycDocuments ProviderKycDocument[]
  locations    ProviderLocation[]
  services     ProviderService[]
  bookings     Booking[]
  chatThreads  ChatThread[]
  reviews      Review[]
  accessGrants MedicalDocumentAccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerType])
  @@index([status])
}

model ProviderKycDocument {
  id               String          @id @default(cuid())
  providerId       String
  provider         ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  kind             String // passport | medical_license | degree | other
  fileKey          String          @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime        @default(now())
}

// ------------------------------------------------------------------
// Geo & currency
// ------------------------------------------------------------------

model Country {
  id       String  @id @default(cuid())
  code     String  @unique
  nameEn   String
  nameFa   String
  flag     String?
  isActive Boolean @default(true)

  cities City[]

  createdAt DateTime @default(now())
}

model City {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  nameEn    String
  nameFa    String
  slug      String
  isActive  Boolean @default(true)

  providerLocations ProviderLocation[]

  createdAt DateTime @default(now())

  @@unique([countryId, slug])
  @@index([slug])
}

model Currency {
  id        String  @id @default(cuid())
  code      String  @unique // e.g. "USD", "IRR"
  name      String
  symbol    String
  isDefault Boolean @default(false)
  enabled   Boolean @default(true)

  services ProviderService[]

  createdAt DateTime @default(now())
}

// ------------------------------------------------------------------
// Provider domain (doctor in MVP)
// ------------------------------------------------------------------

model ProviderLocation {
  id         String          @id @default(cuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name       String
  address    String
  countryId  String
  cityId     String
  city       City            @relation(fields: [cityId], references: [id])
  lat        Float?
  lng        Float?
  isPrimary  Boolean         @default(false)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
}

model ProviderService {
  id              String          @id @default(cuid())
  providerId      String
  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceMode     ServiceMode
  title           String
  description     String?
  priceMinor      Int
  currencyId      String
  currency        Currency        @relation(fields: [currencyId], references: [id])
  durationMinutes Int
  isActive        Boolean         @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([serviceMode])
}

// ------------------------------------------------------------------
// Booking, invoice, payment, ledger
// ------------------------------------------------------------------

model Booking {
  id        String @id @default(cuid())
  bookingNo String @unique // e.g. "BK-8F3K2A"

  patientId  String
  patient    PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    ProviderService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  serviceModeSnapshot    ServiceMode
  priceSnapshotMinor     Int
  currencyCodeSnapshot   String
  platformFeeBpsSnapshot Int
  locationId             String?
  location               ProviderLocation? @relation(fields: [locationId], references: [id])

  meetingLink  String? // online visits: provider-entered third-party link after confirm
  scheduledFor DateTime?
  patientNotes String?

  status          BookingStatus @default(requested)
  requestedAt     DateTime      @default(now())
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  rejectedAt      DateTime?

  invoice     Invoice?
  payments    Payment[]
  chatThreads ChatThread[]
  review      Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([providerId])
  @@index([status])
}

model Invoice {
  id        String  @id @default(cuid())
  invoiceNo String  @unique // e.g. "INV-..."
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status           InvoiceStatus @default(issued)
  subtotalMinor    Int
  platformFeeMinor Int
  totalMinor       Int
  currencyCode     String

  issuedAt DateTime  @default(now())
  dueAt    DateTime?
  paidAt   DateTime?
  voidedAt DateTime?

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now())
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPriceMinor Int
  totalMinor     Int

  createdAt DateTime @default(now())
}

model Payment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amountMinor    Int
  currencyCode   String
  method         String        @default("mock_card")
  status         PaymentStatus @default(pending)
  gatewayRef     String?
  failureReason  String?
  idempotencyKey String        @unique
  payloadJson    Json?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([invoiceId])
  @@index([bookingId])
}

model PaymentWebhookEvent {
  id          String    @id @default(cuid())
  gateway     String
  payloadJson Json
  processed   Boolean   @default(false)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([processed])
}

model LedgerEntry {
  id             String   @id @default(cuid())
  entryNo        String   @unique // sequential "LE-000001"
  accountCode    String // e.g. "patient_wallet", "platform_fee", "provider_payable"
  direction      String // debit | credit
  amountMinor    Int
  currencyCode   String
  referenceType  String // Booking | Invoice | Payment | Payout
  referenceId    String
  description    String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([referenceType, referenceId])
  @@index([accountCode])
}

// ------------------------------------------------------------------
// Reviews
// ------------------------------------------------------------------

model Review {
  id         String          @id @default(cuid())
  bookingId  String          @unique
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  patientId  String
  patient    PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  rating     Int // 1..5
  comment    String?
  status     ReviewStatus @default(pending)
  isVerified Boolean      @default(false) // true when booking is completed

  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
}

// ------------------------------------------------------------------
// Chat + AI translation
// ------------------------------------------------------------------

model ChatThread {
  id         String          @id @default(cuid())
  patientId  String
  patient    PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookingId  String?
  booking    Booking?        @relation(fields: [bookingId], references: [id])

  status   ChatThreadStatus @default(active)
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([providerId])
}

model ChatMessage {
  id           String     @id @default(cuid())
  threadId     String
  thread       ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderLocale String // locale at send time (fa|en|ar)
  originalText String
  edited       Boolean    @default(false) // always false in MVP, kept for future

  translations ChatMessageTranslation[]

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model ChatMessageTranslation {
  id             String      @id @default(cuid())
  messageId      String
  message        ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  targetLocale   String
  translatedText String
  modelUsed      String?

  createdAt DateTime @default(now())

  @@unique([messageId, targetLocale])
  @@index([targetLocale])
}

model AiTranslationSetting {
  id              String              @id @default(cuid())
  provider        TranslationProvider @default(openai)
  apiKeyEncrypted String // AES-256-GCM, never logged or sent to client
  modelName       String
  systemPrompt    String
  active          Boolean             @default(false)
  updatedById     String?
  updatedAt       DateTime            @updatedAt
  createdAt       DateTime            @default(now())
}

// ------------------------------------------------------------------
// Patient medical documents
// ------------------------------------------------------------------

model PatientMedicalDocument {
  id               String         @id @default(cuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fileKey          String         @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  title            String?
  description      String?
  status           DocumentStatus @default(active)

  uploadedAt DateTime  @default(now())
  archivedAt DateTime?

  @@index([patientId])
}

model MedicalDocumentAccessGrant {
  id         String          @id @default(cuid())
  patientId  String
  patient    PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  grantedBy  String // userId (the patient) who granted/revoked
  grantedAt  DateTime        @default(now())
  revokedAt  DateTime?

  @@unique([patientId, providerId])
  @@index([providerId])
}

// ------------------------------------------------------------------
// Notifications & audit
// ------------------------------------------------------------------

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // booking_confirmed | booking_cancelled | invoice_paid | payment_failed | new_chat_message ...
  title       String
  body        String
  payloadJson Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  entityType   String?
  entityId     String?
  metadataJson Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
