# ------------------------------------------------------------------
# WishUBest — environment variables (copy to .env and fill in values)
#   cp .env.example .env
# ------------------------------------------------------------------

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wishubest"
# Used by automated tests; wiped and migrated on every test run
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wishubest_test"

# --- Redis (BullMQ workers; not required for the sync MVP path) ---
REDIS_URL="redis://localhost:6379"

# --- API server ---
API_PORT=8080
API_HOST=0.0.0.0
# Absolute URL the web app uses to reach the API (no trailing slash)
API_URL="http://localhost:8080"
WEB_URL="http://localhost:3000"

# --- Auth ---
# 32+ random chars, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me-to-a-long-random-secret"
# Auth cookie name
AUTH_COOKIE="wishubest_session"
# In seconds
SESSION_TTL_SECONDS=604800

# --- Seed (only used by `pnpm db:seed`) ---
SEED_ADMIN_EMAIL="admin@wishubest.local"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_GEO=true

# --- Storage (private documents) ---
# local = filesystem under STORAGE_LOCAL_DIR (default dev)
# s3    = S3-compatible bucket (MinIO in docker-compose)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage/private-documents"
# S3/MinIO options (used when STORAGE_DRIVER=s3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="private-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# --- Presigned URLs for document download (seconds) ---
DOC_SIGNED_URL_TTL_SECONDS=300

# --- AI translation (values managed at runtime in Admin UI; these are only defaults) ---
# openai | anthropic | mock
TRANSLATION_PROVIDER="mock"
TRANSLATION_MODEL="gpt-4o-mini"
TRANSLATION_API_KEY=""